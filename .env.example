# Copy to .env and fill in. Never commit .env.

# Deepgram — used for BOTH speech-to-text (Flux) and text-to-speech (Aura-2).
# One key, one account. https://console.deepgram.com  ($200 free credit)
DEEPGRAM_API_KEY=

# Groq — the interviewer's reasoning. Free tier, no card.
# https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic — only needed if LLM_PROVIDER=anthropic.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- models (see docs/DECISIONS.md ADR-002/003/004) ---
# groq | anthropic
LLM_PROVIDER=groq
# For groq: openai/gpt-oss-120b (or openai/gpt-oss-20b, qwen/qwen3.8-27b).
# For anthropic: claude-sonnet-5.
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=flux-general-en
TTS_MODEL=aura-2-thalia-en

# --- turn taking ---
# Confidence needed to end the candidate's turn (0.5-0.9). Higher = the
# interviewer waits longer but interrupts less.
EOT_THRESHOLD=0.5
# Confidence needed to START DRAFTING a response (0.3-0.9). Lower = lower
# latency when the guess lands, more discarded tokens when it doesn't.
EAGER_EOT_THRESHOLD=0.3
# Silence that force-ends a turn even at low confidence.
EOT_TIMEOUT_MS=4000

# --- budget guards (docs/COST_MODEL.md) ---
MAX_INTERVIEW_DURATION_S=600
MAX_GENERATION_TOKENS=160
MAX_RESPONSE_CHARS=400
TRANSCRIPT_WINDOW=12
