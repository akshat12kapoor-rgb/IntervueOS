# Copy to .env and fill in. Never commit .env.

# Deepgram — used for BOTH speech-to-text (Flux) and text-to-speech (Aura-2).
# One key, one account. https://console.deepgram.com  ($200 free credit)
DEEPGRAM_API_KEY=

# Groq — the interviewer's reasoning. Free tier, no card.
# https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic — only needed if LLM_PROVIDER=anthropic.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- provider selection (see docs/DECISIONS.md ADR-002/003/004/008/009) ---
# Each stage switches independently. Nothing below needs a code change.
#
# RECOMMENDED (ADR-009): STT_PROVIDER=groq with TTS_PROVIDER=deepgram.
# Free speech-to-text, Deepgram keeps the voice: 52% off the Deepgram bill
# ($0.375 -> $0.180 per 30-min interview). The defaults below are the
# all-Deepgram setup, which is what this file ships with.

# groq | anthropic
LLM_PROVIDER=groq
# deepgram | groq
#   deepgram = Flux. Native turn detection incl. speculative EagerEndOfTurn.
#              ~$0.195 per 30-min interview. Measured faster on long answers.
#   groq     = whisper-large-v3 + the local VAD. Free and more accurate on
#              technical terms, but no speculation, and slower above ~8-second
#              answers. Measured numbers in docs/LATENCY.md.
STT_PROVIDER=deepgram
# deepgram | groq
#   groq = Orpheus. REJECTED (ADR-009), kept only so a future revisit is a
#          config change rather than a rewrite: it is terms-gated on this
#          account, and ~10 req/min / ~100 req/day works out to roughly ONE
#          30-minute interview per day. Do not switch this without reading
#          ADR-009.
TTS_PROVIDER=deepgram

# For groq: openai/gpt-oss-120b (or openai/gpt-oss-20b, qwen/qwen3.8-27b).
# For anthropic: claude-sonnet-5.
LLM_MODEL=openai/gpt-oss-120b
# Used when STT_PROVIDER / TTS_PROVIDER = deepgram.
STT_MODEL=flux-general-en
TTS_MODEL=aura-2-thalia-en
# Used when STT_PROVIDER / TTS_PROVIDER = groq.
# whisper-large-v3 | whisper-large-v3-turbo — both free with identical rate
# limits; large-v3 measured a third of turbo's word error rate on the
# technical terms an interview is about.
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn | diana | hannah (F), austin | daniel | troy (M)
GROQ_TTS_VOICE=autumn

# --- turn taking, local VAD (STT_PROVIDER=groq only, ADR-009) ---
# Silence that ends a turn. This IS the end-of-turn latency budget — unlike
# Flux's confidence threshold there is nothing clever to do, so the number is
# the lag. Below ~500 ms an ordinary mid-sentence pause cuts the candidate off.
VAD_END_SILENCE_MS=700
# Speech needed to open a turn; guards against clicks and coughs.
VAD_START_MS=100
# Audio kept from before the trigger, so Whisper hears the first consonant.
VAD_PREROLL_MS=300
# webrtcvad 0-3. Higher filters more non-speech; 3 clips quiet openings.
VAD_AGGRESSIVENESS=2
# How often to transcribe an increment for the live caption. Every one is a
# request against a 20 RPM ceiling shared with the end-of-turn transcriptions
# that actually matter. 0 disables captions.
STT_INTERIM_INTERVAL_S=4.0
STT_REQUESTS_PER_MINUTE=20
# Held back from captions so an end-of-turn request always gets through.
STT_RESERVE_REQUESTS=6

# --- turn taking (STT_PROVIDER=deepgram only) ---
# Confidence needed to end the candidate's turn (0.5-0.9). Higher = the
# interviewer waits longer but interrupts less.
EOT_THRESHOLD=0.5
# Confidence needed to START DRAFTING a response (0.3-0.9). Lower = lower
# latency when the guess lands, more discarded tokens when it doesn't.
EAGER_EOT_THRESHOLD=0.3
# Silence that force-ends a turn even at low confidence.
EOT_TIMEOUT_MS=4000

# --- budget guards (docs/COST_MODEL.md) ---
MAX_INTERVIEW_DURATION_S=600
MAX_GENERATION_TOKENS=160
MAX_RESPONSE_CHARS=400
TRANSCRIPT_WINDOW=12
